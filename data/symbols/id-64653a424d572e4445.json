      "providers": [
        {
          "display_name": "Grok",
          "execution_status": "SUCCESS",
          "provider": "xai",
          "rank": 1,
          "reason": "Recent 5-day gain of ~4% and daily volume surge signal technical recovery from €56-60 lows. Citi catalyst watch and Sept 30 CMD provide near-term attention without relying on unconfirmed operational beats.",
          "risk": "China demand weakness and 2026 margin guidance of 1-3% already weighing on sentiment; any CMD disappointment could reverse bounce quickly.",
          "score": 65,
          "selected": true
        },
        {
          "display_name": "Gemini",
          "execution_status": "SUCCESS",
          "provider": "gemini",
          "rank": 1,
          "reason": "BMW shows strong technical momentum with a consensus 'Strong Buy' across multiple moving averages (MA5 to MA200) and oscillators. Despite prior profit warnings, recent price stabilization in China and robust demand for the 'Neue Klasse' iX3 models provide a technical floor, supported by an active €2B share buyback program and attractive valuation below historical averages.",
          "risk": "Prolonged demand weakness in China or unexpected margin compression from escalating EU-China trade tariffs.",
          "score": 85,
          "selected": true
        },
        {
          "display_name": "DeepSeek",
          "execution_status": "SUCCESS",
          "provider": "deepseek",
          "rank": 1,
          "reason": "Inverse head-and-shoulders completed 28 Aug on high volume; the pullback held €60–61 and the stock has reclaimed its 50-day average and moved above the €62.72 confirmation level, opening measured targets near €65.50/66.84. Deutsche Bank (Buy, €90) and Bernstein (Outperform, €82) provide sentiment support into late-September's capital markets day.",
          "risk": "Fundamentals are weak: Q2 pretax profit fell roughly 35% with auto margin guided to 1–3%, and a daily close back below €62.72/€60 would negate the breakout and risk renewed selling.",
          "score": 62,
          "selected": true
        },
        {
          "display_name": "Qwen",
          "execution_status": "SUCCESS",
          "provider": "qwen",
          "rank": 1,
          "reason": "Confirmed inverse head-and-shoulders breakout above €59.75 neckline with €63.41 target achieved. Citi opened 90-day upside catalyst watch running into Sept 30 Capital Markets Day (first under new CEO), providing near-term event support. Stock remains ~40% below 200-day EMA with analyst consensus target ~€77 offering substantial upside.",
          "risk": "Profit-taking after 5% rally in four sessions; guidance cut overhang (EBIT margin lowered to 1-3%) and China/Middle East headwinds could trigger broader sector selling that overrides technical setup.",
          "score": 68,
          "selected": true
        },
